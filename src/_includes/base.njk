<html lang="en-US">
  <head>
    <meta charset="UTF-8">
    <meta name="robots" content="noindex">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap">
    {% set css %}
      {% include "css/base.css" %}
      {% if tags and 'game' in tags  %}
      {% include "css/game.css" %}
      {% endif %}
    {% endset %}
    <style>
      {{ css | cssmin | safe }}
    </style>
    {% if tags and 'game' in tags  %}
    <script src="./countdown.js"></script>
    <script src="./game.js" type="module"></script>
    {% endif %}
    {% if libraries === 'floatingui' %}
    <script src="https://cdn.jsdelivr.net/npm/@floating-ui/core@1.7.3"></script>
    <script src="https://cdn.jsdelivr.net/npm/@floating-ui/dom@1.7.4"></script>
    <script src="./tooltip.js" type="module"></script>
    {% endif %}
  </head>
  <body>
    {{ content | safe }}
    <footer role="contentinfo">
      <nav aria-label="The Accessibility Impostors Game Show">
        <a href="/">{{ site.name }}</a>
        <ol>
          {%- for round in collections.game -%}
          <li>
            <a href="{{round.url}}" {% if page.url == round.url %} aria-current="page"{% endif %}>{{ round.data.h1 }}</a>
          </li>
          {%- endfor -%}
        </ol>
      </nav>
      <a href="https://www.deque.com/axe-con/">
        <img src="img/axe-con-logo.svg" alt="axe-con 2026">
      </a>
    </footer>
  </body>
</html>
